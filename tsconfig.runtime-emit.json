{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": false,
    "outDir": ".runtime-cjs",
    "rootDir": "src/runtime",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/runtime/*.cts", "src/runtime/electron.d.ts"]
}
